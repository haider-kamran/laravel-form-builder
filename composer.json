{
    "name": "hyderkamran/laravel-form-builder",
    "version": "1.0.0",
    "description": "A production-ready, dynamic form builder package for Laravel — drag-and-drop admin UI, 21 field types, conditional logic, file uploads, repeater fields, submissions export, and API support.",
    "keywords": ["laravel", "form-builder", "forms", "dynamic-forms", "drag-and-drop", "form-submission"],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/hyderkamran/laravel-form-builder",
    "authors": [
        {
            "name": "Kamran Haider",
            "email": "hyderkamran@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support":    "^10.0|^11.0",
        "illuminate/database":   "^10.0|^11.0",
        "illuminate/routing":    "^10.0|^11.0",
        "illuminate/view":       "^10.0|^11.0",
        "illuminate/validation": "^10.0|^11.0",
        "illuminate/http":       "^10.0|^11.0",
        "illuminate/mail":       "^10.0|^11.0",
        "phpoffice/phpspreadsheet": "^1.30|^2.0",
        "dompdf/dompdf": "^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Hyderkamran\\FormBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hyderkamran\\FormBuilder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hyderkamran\\FormBuilder\\FormBuilderServiceProvider"
            ],
            "aliases": {
                "FormBuilder": "Hyderkamran\\FormBuilder\\Facades\\FormBuilder"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
